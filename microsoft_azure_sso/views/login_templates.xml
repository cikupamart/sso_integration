<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="microsoft_sso_login_button" inherit_id="web.login" name="Microsoft SSO Login Button">
        <xpath expr="//div[hasclass('oe_login_buttons')]" position="inside">
            <t t-if="request.env['ir.config_parameter'].sudo().get_param('microsoft_azure_sso.enabled') in ('True', '1', 'true')">
                <hr class="my-3"/>
                <a t-attf-href="/microsoft_sso/login?redirect=#{request.params.get('redirect', '/web')}"
                   class="btn btn-secondary btn-block w-100 d-flex align-items-center justify-content-center gap-2"
                   style="gap:8px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 23 23">
                        <rect x="1" y="1" width="10" height="10" fill="#f25022"/>
                        <rect x="12" y="1" width="10" height="10" fill="#7fba00"/>
                        <rect x="1" y="12" width="10" height="10" fill="#00a4ef"/>
                        <rect x="12" y="12" width="10" height="10" fill="#ffb900"/>
                    </svg>
                    <span>Login with Microsoft</span>
                </a>
            </t>
        </xpath>
        <xpath expr="//div[hasclass('oe_login_buttons')]" position="before">
            <t t-if="request.params.get('sso_error')">
                <div class="alert alert-danger" role="alert">
                    <t t-esc="request.params.get('sso_error')"/>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
