<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sso" model="ir.module.category">
        <field name="name">Microsoft SSO</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_sso_admin" model="res.groups">
        <field name="name">Microsoft SSO Administrator</field>
        <field name="category_id" ref="module_category_sso"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can configure Microsoft SSO and view every user's audit logs / dashboard.</field>
    </record>

    <!-- Anyone who has access to Settings (base.group_system) automatically
         becomes a Microsoft SSO Administrator too, so the configuration
         screen and full audit log are usable right after install without
         any manual group assignment. -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_sso_admin'))]"/>
    </record>

    <record id="sso_audit_log_rule_own" model="ir.rule">
        <field name="name">SSO Audit Log: own records only</field>
        <field name="model_id" ref="model_sso_audit_log"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="sso_audit_log_rule_admin" model="ir.rule">
        <field name="name">SSO Audit Log: administrators see all records</field>
        <field name="model_id" ref="model_sso_audit_log"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_sso_admin'))]"/>
    </record>
</odoo>
